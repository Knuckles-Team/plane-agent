@prefix ac: <https://knuckles-team.github.io/ontology/access#> .
@prefix : <https://knuckles-team.github.io/ontology/connector/plane#> .

# Read contracts for the classes declared by plane.ttl.  The MCP tools expose
# both read and write operations, but these mappings select the list/retrieve
# tools only.  The source classes remain distinct from any unapproved hub
# crosswalk; in particular, Plane Issue is not asserted to be an Incident.

:workspaceAccess a ac:AccessContract ;
    ac:classIri :Workspace ;
    ac:sourceId "plane-agent" ;
    ac:entity "workspace" ;
    ac:keyField "slug" ;
    ac:accessKind "mcp_tool" ;
    ac:operation "plane_get_workspace" ;
    ac:pagination "none" ;
    ac:authRef "env://PLANE_API_KEY" ;
    ac:rateLimitPerMinute 60 ;
    ac:freshnessSeconds 300 ;
    ac:costHint "low" .

:softwareProjectAccess a ac:AccessContract ;
    ac:classIri :SoftwareProject ;
    ac:sourceId "plane-agent" ;
    ac:entity "project" ;
    ac:keyField "id" ;
    ac:accessKind "mcp_tool" ;
    ac:operation "plane_list_projects" ;
    ac:parameter "per_page", "cursor", "order_by" ;
    ac:pagination "cursor" ;
    ac:pushdown "filter", "limit", "sort" ;
    ac:authRef "env://PLANE_API_KEY" ;
    ac:rateLimitPerMinute 60 ;
    ac:freshnessSeconds 300 ;
    ac:costHint "low" .

:softwareProjectIdentifierBinding a ac:PropertyBinding ;
    ac:contract :softwareProjectAccess ; ac:property :identifier ; ac:field "identifier" .

:issueAccess a ac:AccessContract ;
    ac:classIri :Issue ;
    ac:sourceId "plane-agent" ;
    ac:entity "work_item" ;
    ac:keyField "id" ;
    ac:accessKind "mcp_tool" ;
    ac:operation "plane_list_work_items" ;
    ac:parameter "project_id", "params_json" ;
    ac:pagination "cursor" ;
    ac:pushdown "filter", "limit", "sort" ;
    ac:authRef "env://PLANE_API_KEY" ;
    ac:rateLimitPerMinute 60 ;
    ac:freshnessSeconds 60 ;
    ac:costHint "medium" .

:issueSequenceIdBinding a ac:PropertyBinding ;
    ac:contract :issueAccess ; ac:property :sequenceId ; ac:field "sequence_id" .

:issuePriorityBinding a ac:PropertyBinding ;
    ac:contract :issueAccess ; ac:property :priority ; ac:field "priority" .

:issueStateBinding a ac:PropertyBinding ;
    ac:contract :issueAccess ; ac:property :state ; ac:field "state" .

:issuePullRequestUrlBinding a ac:PropertyBinding ;
    ac:contract :issueAccess ; ac:property :pullRequestUrl ; ac:field "pullRequestUrl" .

:cycleAccess a ac:AccessContract ;
    ac:classIri :Cycle ;
    ac:sourceId "plane-agent" ;
    ac:entity "cycle" ;
    ac:keyField "id" ;
    ac:accessKind "mcp_tool" ;
    ac:operation "plane_list_cycles" ;
    ac:parameter "project_id", "params_json" ;
    ac:pagination "cursor" ;
    ac:pushdown "filter", "limit", "sort" ;
    ac:authRef "env://PLANE_API_KEY" ;
    ac:rateLimitPerMinute 60 ;
    ac:freshnessSeconds 300 ;
    ac:costHint "medium" .

:cycleStartDateBinding a ac:PropertyBinding ;
    ac:contract :cycleAccess ; ac:property :startDate ; ac:field "start_date" .

:cycleEndDateBinding a ac:PropertyBinding ;
    ac:contract :cycleAccess ; ac:property :endDate ; ac:field "end_date" .

:moduleAccess a ac:AccessContract ;
    ac:classIri :PlaneModule ;
    ac:sourceId "plane-agent" ;
    ac:entity "module" ;
    ac:keyField "id" ;
    ac:accessKind "mcp_tool" ;
    ac:operation "plane_list_modules" ;
    ac:parameter "project_id", "params_json" ;
    ac:pagination "cursor" ;
    ac:pushdown "filter", "limit", "sort" ;
    ac:authRef "env://PLANE_API_KEY" ;
    ac:rateLimitPerMinute 60 ;
    ac:freshnessSeconds 300 ;
    ac:costHint "medium" .

:projectStateAccess a ac:AccessContract ;
    ac:classIri :ProjectState ;
    ac:sourceId "plane-agent" ;
    ac:entity "state" ;
    ac:keyField "id" ;
    ac:accessKind "mcp_tool" ;
    ac:operation "plane_list_states" ;
    ac:parameter "project_id", "params_json" ;
    ac:pagination "cursor" ;
    ac:pushdown "filter", "limit", "sort" ;
    ac:authRef "env://PLANE_API_KEY" ;
    ac:rateLimitPerMinute 60 ;
    ac:freshnessSeconds 300 ;
    ac:costHint "low" .

:labelAccess a ac:AccessContract ;
    ac:classIri :Label ;
    ac:sourceId "plane-agent" ;
    ac:entity "label" ;
    ac:keyField "id" ;
    ac:accessKind "mcp_tool" ;
    ac:operation "plane_list_labels" ;
    ac:parameter "project_id", "params_json" ;
    ac:pagination "cursor" ;
    ac:pushdown "filter", "limit", "sort" ;
    ac:authRef "env://PLANE_API_KEY" ;
    ac:rateLimitPerMinute 60 ;
    ac:freshnessSeconds 300 ;
    ac:costHint "low" .
